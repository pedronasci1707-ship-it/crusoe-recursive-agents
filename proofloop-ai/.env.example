# Copie para .env e preencha. O .env não vai para o git.
CRUSOE_API_KEY=cole-sua-chave-aqui
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# IDs exatos de GET /v1/models (diferenciam maiúsculas/minúsculas)
PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
BUILDER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
REVIEWER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Pacotes extras que o projeto gerado pode instalar (além da lista em core/packages.py)
ALLOWED_PACKAGES=
